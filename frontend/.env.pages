VITE_STATIC=1
# Same reasoning as .env.plugin: the publishable anon key is not a credential.
#
# Pages carries the endpoint too, so the public demo reads the same live
# portrait bucket the plugin does. That is the point of the demo -- a portrait
# dropped into the bucket appears there with no rebuild, which is exactly the
# property the plugin depends on and the thing a static bundle cannot show on
# its own. Only what is deliberately mirrored is visible.
VITE_SUPABASE_URL=https://xbpimnerxjpwqnicwpec.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_LG2eHM6wdkMQYHUGTE0Xtg_VUxP4KGp
